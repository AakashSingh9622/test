{
  "name": "warehouse-api",
  "version": "1.0.0",
  "description": "Warehouse Management API — Node.js, Express, Supabase Postgres (Prisma 7), admin login verified against DocuSoft.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/scripts/seed.js",
    "slots:recompute": "node src/scripts/recomputeSlotUsage.js",
    "locations:refresh": "node src/scripts/refreshLocationPaths.js",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
