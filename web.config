<?xml version="1.0" encoding="utf-8"?>
<!-- Plesk (Windows / IIS + iisnode). Saari requests server.js (Express) ko jati hain.
     Secrets (.env) yahan mat likhna -- .env file server par alag se rakho. -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- 1) Pehle HTTP -> HTTPS -->
        <rule name="HTTPS Redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- 2) Baaki sab kuch server.js par -->
        <rule name="NodeApp" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Source, config aur secrets browser se download na ho sakein -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="src" />
          <add segment="prisma" />
          <add segment="docs" />
          <add segment=".env" />
          <add segment=".git" />
          <add segment="iisnode" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- TEMPORARY debug: asli error dikhane ke liye. Sab theek hone par is line ko hata do. -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

    <iisnode loggingEnabled="true" logDirectory="iisnode" />
  </system.webServer>
</configuration>
