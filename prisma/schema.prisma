// Warehouse Management -- Supabase Postgres schema (pehle MongoDB/Mongoose tha).
// Actor/location snapshots jaise chhote embedded objects Json columns me hain (display-only
// snapshots, kabhi query nahi hote); jinpe filter/join hota hai wo proper columns/relations hain.
generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL schema me nahi, prisma.config.js me hai (CLI ke liye) aur runtime
// me driver adapter (src/config/prisma.js) se aata hai. Generator "prisma-client-js" (plain JS/CJS)
// jaan-boojhkar -- naya "prisma-client" generator sirf TypeScript files banata hai, aur ye backend
// poora JavaScript hai.
datasource db {
  provider = "postgresql"
}

// Staff roles: staff_admin sirf DocuSoft ke admin flag (strIsAdmin) se aata hai; baaki staff roles user_role table me
// locally assign hote hain. Kaunsa role kya kar sakta hai: src/auth/permissions.js. client_* sirf portal token me.
enum Role {
  staff_admin
  staff_operator // warehouse operator
  warehouse_admin
  operations_manager
  records_manager // records / compliance manager
  finance_manager // billing / finance manager
  auditor // read-only
  client_admin
  client_user
}

// available / full = an ACTIVE cell (full = no room left). blocked / quarantined / inactive = no new boxes go in;
// boxes already inside stay there and keep counting in `used`.
enum SlotStatus {
  available
  full
  blocked
  quarantined // something is wrong with the location (damage, pests, ...) -- under investigation
  inactive // not in use (e.g. rack being decommissioned)
}


enum BoxStatus {
  unallocated
  stored
  reserved
  picked
  out
  pending_destruction
  destroyed
  missing
  digitized // scanned/digitised: still in its slot, flagged (see Box.digitizedAt)
  received // at the warehouse's Goods-In (Box.goodsInWarehouseId), not on a shelf yet
  return_pending // with the client, on an open collection order that brings it back
  quarantined // damaged / under investigation: stays where it is, can't go on any order (Box.quarantineReason)
  permanently_withdrawn // given back to the client for good (dispatch order with permanentWithdrawal)
}

enum OrderType {
  collection
  dispatch
  destruction
  digitize
}

enum OrderStatus {
  requested
  approved // before the billing stage existed: old orders only, still schedulable
  billing // approved; waiting for the invoice to be paid (or billing waived) before it can be scheduled
  scheduled
  in_progress
  ready // every box picked -- waiting to be dispatched / destroyed
  on_hold // paused by a supervisor; resume goes back to Order.heldFromStatus
  completed
  cancelled
  rejected
}

enum RequestedVia {
  staff
  portal
}

enum OrderLineStatus {
  pending
  picked
  dispatched
  received
  destroyed
  digitized
  missing
  removed
}

enum AuditEventType {
  registered
  label_printed
  allocated
  moved
  details_edited
  added_to_order
  removed_from_order
  picked
  dispatched
  collected
  received
  refiled
  marked_missing
  destruction_authorised
  destroyed
  digitization_authorised
  digitized
  hold_placed
  hold_released
  status_changed
  quarantined
  quarantine_released
  relabelled
  goods_in // a newly registered box arrived at a warehouse's Goods-In (staff only; a box back from the client is "received")
  legal_hold_placed
  legal_hold_released
  destruction_approved // the second person signed off a destruction order
  contents_changed
}

// Small key/value settings kept in the DATABASE (so they can be changed without touching the code).
//   defaultDatabase = the DocuSoft agreement number (agrno) this system is built for, e.g. "0003".
//   Only users whose DocuSoft agreement is that number can log in (staff login AND the client portal).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy Json?

  @@map("app_setting")
}

// Login identity cache -- password yahan kabhi store nahi hota (DocuSoft verify karta hai).
model WHUser {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  docusoftUserId Int
  agreementNo    String
  isAdmin        Boolean  @default(false) // DocuSoft strIsAdmin at the last login -> staff_admin
  role           Role     @default(staff_admin) // legacy: main role at the last login; real roles = isAdmin + user_role
  lastLoginAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("wh_user")
}

// Locally assigned staff roles (everything except staff_admin, which comes from DocuSoft). Keyed by e-mail, not by
// wh_user id, so an admin can give someone a role before their first login. No rows (and not a DocuSoft admin) =
// staff_operator, the default for every DocuSoft user of this agreement.
model UserRole {
  email      String // lower-case
  role       Role
  assignedBy Json // Actor
  assignedAt DateTime @default(now())

  @@id([email, role])
  @@map("user_role")
}

enum AdminAction {
  role_assigned
  role_removed
  warehouse_created
  rack_created
  rack_updated
  slot_updated
  zone_created
  zone_updated
  zone_deleted
  aisle_created
  aisle_updated
  aisle_deleted
  box_sizes_updated
  box_size_created
  box_size_deleted
  sage_settings_updated
  invoice_created
  invoice_deleted
  invoice_issued
  retention_rule_saved
  legal_hold_placed
  legal_hold_released
  rate_card_saved
  charge_voided
  charge_added
  billing_run_created
  billing_run_approved
  billing_run_discarded
  order_payment_recorded
  order_billing_waived
  order_payment_requirement_changed
  order_invoice_acknowledged
  invoice_payment_recorded
  invoices_synced_from_sage
}

// Append-only history of admin / configuration changes (roles, warehouse layout, settings) -- audit_event sirf
// boxes ke liye hai (boxId zaroori), isliye ye alag table.
model AdminAuditEvent {
  id         String      @id @default(uuid())
  action     AdminAction
  entityType String // "user" | "warehouse" | "rack" | "slot" | "settings"
  entityId   String? // email for a user, id for a location
  summary    String // one readable sentence, e.g. "Gave auditor to asha@x.com"
  changes    Json? // [{ field, from?, to? }]
  actor      Json
  at         DateTime    @default(now())

  @@index([at])
  @@index([entityType, entityId])
  @@map("admin_audit_event")
}

model Warehouse {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String // unique (case-insensitive) is enforced in locationService.createWarehouse
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  racks     Rack[]
  slots     Slot[]
  zones     Zone[]
  aisles    Aisle[]

  @@map("warehouse")
}

// Optional layout levels above the rack (Sprint 10): warehouse -> zone -> aisle -> rack. Small warehouses can skip
// them. Shelf = the rack's row, position = the cell (slot) -- slots are not touched. An aisle may sit in a zone or
// directly in the warehouse; a rack in an aisle always carries that aisle's zone (locationService keeps it in step).
model Zone {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  name        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  aisles      Aisle[]
  racks       Rack[]

  @@unique([warehouseId, code])
  @@map("zone")
}

model Aisle {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  zoneId      String?
  zone        Zone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  code        String // unique in the warehouse (not just the zone), so "Aisle 3" is never ambiguous
  name        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  racks       Rack[]

  @@unique([warehouseId, code])
  @@index([zoneId])
  @@map("aisle")
}

model Rack {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  // Optional (Sprint 10). Deleting a zone / aisle that still has racks is refused in locationService.
  zoneId      String?
  zone        Zone?     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  aisleId     String?
  aisle       Aisle?    @relation(fields: [aisleId], references: [id], onDelete: SetNull)
  // New / renamed racks: unique across ALL warehouses (checked in locationService), so "B04-3" finds a shelf on its
  // own. The DB only enforces per warehouse because older racks may share a code across warehouses.
  code        String
  label       String
  rows        Int
  columns     Int
  // Har cell (row x column) ek hi storage location hai; iski length centimetre me store hoti hai
  // (user feet de to convert hoke). Slot.capacity isi ka copy hai, cell ke hisaab se edit ho sakta hai.
  cellLengthCm Int       @default(400)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  slots       Slot[]

  @@unique([warehouseId, code])
  @@index([zoneId])
  @@index([aisleId])
  @@map("rack")
}

model Slot {
  id          String     @id @default(uuid())
  rackId      String
  rack        Rack       @relation(fields: [rackId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  barcode     String     @unique
  row         Int
  column      Int
  capacity    Int        @default(400) // cell ki length, centimetre me
  used        Int        @default(0) // boxes ki total length (cm) jo is cell me hain
  status      SlotStatus @default(available)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  boxes       Box[]

  @@index([rackId])
  @@index([warehouseId])
  @@map("slot")
}

model Box {
  id             String    @id @default(uuid())
  boxNumber      String    @unique
  barcode        String    @unique
  clientId       String // DocuSoft ClientID reference -- local Client table kabhi nahi
  clientName     String
  description    String
  department     String?
  reference      String?
  filingDateFrom DateTime  @db.Date
  filingDateTo   DateTime? @db.Date
  destroyAfter   DateTime? @db.Date
  size           String // box_size_config.size code ("standard", "large" or one an admin added) -- Sprint 11
  lengthCm       Int? // cm this box takes in a cell, copied from box_size_config when registered (so later setting changes don't corrupt slot.used)
  status         BoxStatus @default(unallocated)
  onHold         Boolean   @default(false)
  holdReason     String?
  missingReason  String? // why it was marked missing (status = missing)
  missingAt      DateTime?
  digitizedAt    DateTime? // set when a digitize order completes; keeps the box "digitized" again after a later order is cancelled
  goodsInWarehouseId String? // status "received": which warehouse's Goods-In it is waiting in
  quarantineReason String? // status "quarantined": why
  quarantinedAt  DateTime?
  retentionCategory String? // RetentionRule.code -- how long the box must be kept (spec §4.4)
  labelPrinted   Boolean   @default(false)
  slotId         String?
  slot           Slot?     @relation(fields: [slotId], references: [id], onDelete: SetNull)
  locationPath   Json? // { warehouse, zone?, aisle?, rack, slot, shelf?, position? } snapshot (older rows: { warehouse, rack, slot })
  openOrderId    String? // open order ka id (filter ke liye)
  openOrder      Json? // { id, orderNumber, type, status } snapshot
  createdBy      Json // Actor
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orderLines  OrderLine[]
  auditEvents AuditEvent[]
  movements   Movement[]
  contents    BoxContent[]

  // Portal lists a client's boxes (optionally by status), newest first -> composites cover filter + sort.
  @@index([clientId, status])
  @@index([clientId, createdAt])
  @@index([status])
  @@index([slotId])
  @@index([openOrderId])
  @@index([createdAt])
  @@map("box")
}

// Box sizes (Sprint 11): the two built-in ones (standard, large) plus any an admin adds -- a name and the length (cm)
// one box takes along a rack cell. `size` is a stable code made from the first name, so renaming never touches boxes.
// A size in use can only be retired (no new boxes), not deleted -- boxSizeService.
model BoxSizeConfig {
  size      String   @id // code, e.g. "standard", "archive-xl"
  name      String? // shown everywhere; null on the old built-in rows -> "Standard" / "Large"
  lengthCm  Int
  active    Boolean  @default(true) // false = retired: kept for existing boxes, not offered for new ones
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  updatedBy Json?

  @@map("box_size_config")
}

model Order {
  id             String       @id @default(uuid())
  orderNumber    String       @unique
  type           OrderType
  status         OrderStatus  @default(requested)
  clientId       String
  clientName     String
  requestedBy    Json // Actor
  requestedVia   RequestedVia
  scheduledFor   DateTime?    @db.Date
  completedAt    DateTime?
  address        String?
  contactName    String?
  // Email of the client contact this order is for (lower-case). With clientId it is how an order is tied to a
  // person: a client-side login (clientId + contact email) only sees its own orders -- see searchOrders.
  contactEmail   String?
  contactPhone   String?
  notes          String?
  boxCount       Int          @default(0)
  lineSummary    Json         @default("{}") // { <OrderLineStatus>: count }
  destruction    Json? // { method, authorisedBy, authorisedAt, witness? }
  digitization   Json? // { name, note?, authorisedBy, authorisedAt } -- the client's sign-off for a digitize order
  collectionInfo Json? // { expectedNewBoxes } -- API me "collection" naam se aata hai
  permanentWithdrawal Boolean @default(false) // dispatch only: the boxes go back to the client for good
  heldFromStatus OrderStatus? // status "on_hold": the status to go back to on resume
  holdReason     String?
  // Destruction asked for by an ordinary client contact waits for the client's main contact (portal) before the
  // warehouse can approve it.
  clientApprovalRequired Boolean @default(false)
  clientApprovedBy String?
  clientApprovedAt DateTime?
  delivery       Json? // dispatch: { courier?, trackingRef?, receivedBy?, proofReference?, deliveredAt? }
  billing        Json? // billing stage: { status, paymentNotRequired?, invoiceId?, amount?, payment?, acknowledged?, waived? } -- orderBillingService.js
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  lines       OrderLine[]
  auditEvents AuditEvent[]

  // A contact's orders (clientId + contactEmail) and a client's orders (main contact), newest first.
  @@index([clientId, createdAt])
  @@index([clientId, contactEmail, createdAt])
  @@index([type, status])
  @@index([createdAt])
  @@map("order")
}

model OrderLine {
  id           String          @id @default(uuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  boxId        String?
  box          Box?            @relation(fields: [boxId], references: [id], onDelete: SetNull)
  boxNumber    String?
  status       OrderLineStatus @default(pending)
  fromLocation Json?
  scannedAt    DateTime?
  scannedBy    Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([orderId])
  @@index([boxId])
  @@map("order_line")
}

// Append-only -- kabhi update/delete nahi hota.
model AuditEvent {
  id              String         @id @default(uuid())
  boxId           String
  box             Box            @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxNumber       String
  clientId        String
  type            AuditEventType
  at              DateTime       @default(now())
  actor           Json
  orderId         String?
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderNumber     String?
  fromLocation    Json?
  toLocation      Json?
  changes         Json? // [{ field, from?, to? }]
  note            String?
  visibleToClient Boolean
  createdAt       DateTime       @default(now())

  @@index([at])
  @@index([boxId, at])
  @@index([boxId, visibleToClient, at]) // portal history of one box (client-visible events only)
  @@index([clientId])
  @@index([orderId])
  @@map("audit_event")
}

enum MovementType {
  put_away // first placement into a slot: a newly registered box, or a box back from the client
  transfer // slot -> slot
  found // a box marked missing is placed in a slot again
  dispatched // slot -> out with the client
  destroyed // slot -> destroyed
  marked_missing // slot -> unknown
  received // into a warehouse's Goods-In (no slot yet): a new box arriving, or a box back from the client
}

// Custody / location ledger (spec §4.1) -- append-only, kabhi update/delete nahi hota. Har physical location change
// ki ek row. audit_event display history hai (location sirf readable snapshot); yahan asli slot/warehouse ids hain,
// isliye storage billing (har warehouse me box-days, spec §7.2) isi se nikalti hai.
model Movement {
  id              String       @id @default(uuid())
  boxId           String
  box             Box          @relation(fields: [boxId], references: [id], onDelete: Cascade)
  boxNumber       String
  clientId        String
  type            MovementType
  fromSlotId      String? // plain ids, no FK: the ledger must outlive layout changes
  fromWarehouseId String?
  toSlotId        String?
  toWarehouseId   String?
  fromLocation    Json? // { warehouse, rack, slot } snapshot, same as audit_event
  toLocation      Json?
  orderId         String?
  orderNumber     String?
  reason          String?
  actor           Json
  at              DateTime     @default(now())

  @@index([boxId, at])
  @@index([clientId, at])
  @@index([at])
  @@map("movement")
}

enum InvoiceStatus {
  draft // being prepared in the WMS
  sending // a browser is creating it in Sage right now (see Invoice.sendingSince)
  issued // created in Sage -- frozen from here on
}

// A warehouse invoice for one client. Prepared here (lines suggested from warehouse activity), then created in
// Sage One BY THE BROWSER (Sage tokens live in the browser, same as DocuSoft Practice). The backend only records
// what happened: "sending" lock before the Sage call, Sage ids/link after it.
// Real billing (contracts, charge events, billing runs -- roadmap Sprints 5-6) will feed these lines later.
model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique // "WMS-INV-000001" -- also the Sage invoice reference (used to find it again)
  clientId      String // DocuSoft ClientID
  clientName    String
  periodFrom    DateTime?     @db.Date
  periodTo      DateTime?     @db.Date
  invoiceDate   DateTime      @db.Date
  dueDate       DateTime      @db.Date
  notes         String?
  status        InvoiceStatus @default(draft)
  netTotal      Decimal       @default(0) @db.Decimal(19, 4) // sum of qty x unit price; VAT is worked out by Sage
  sendingSince  DateTime? // when the current "sending" attempt started
  lastError     String? // why the last attempt to create it in Sage failed
  billingRunId  String? // made by this billing run (Sprint 6); null = prepared by hand
  orderId       String? // the order this invoice bills (billing stage); null = not for one order
  grossTotal    Decimal?      @db.Decimal(19, 4) // total incl. VAT as Sage worked it out -- what the customer pays
  currency      String? // Sage's currency id, e.g. GBP
  amountPaid    Decimal       @default(0) @db.Decimal(19, 4) // paid so far (WMS payments, or what Sage says after a sync)
  paidAt        DateTime? // when it became fully paid
  payments      Json? // [{ amount, method, reference?, note?, via: portal|staff|sage, by, at }]
  sageSyncedAt  DateTime? // last "Update from Sage" for this invoice
  sageContactId String?
  sageBusinessId String?
  sageInvoiceId String?
  sageInvoiceNumber String?
  sageLink      String?
  issuedAt      DateTime?
  issuedBy      Json?
  createdBy     Json
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lines         InvoiceLine[]

  @@index([clientId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([orderId])
  @@map("invoice")
}

model InvoiceLine {
  id              String  @id @default(uuid())
  invoiceId       String
  invoice         Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position        Int
  kind            String // storage | intake | collection | dispatch | destruction | digitize | other
  description     String
  quantity        Decimal @db.Decimal(19, 4)
  unitPrice       Decimal @db.Decimal(19, 4)
  taxRateId       String // Sage tax rate id, e.g. GB_STANDARD, GB_ZERO, GB_NO_TAX
  ledgerAccountId String? // Sage ledger account; empty = the invoice-wide one chosen when sending
  sourceType      String? // "order" when the line came from a completed order
  sourceId        String? // the order id -- so the same order is not suggested again

  @@index([invoiceId])
  @@index([sourceType, sourceId])
  @@map("invoice_line")
}

enum ExceptionType {
  box_not_found // a scanned box barcode isn't known
  slot_not_found // a scanned slot barcode isn't known
  wrong_box // picked / received a box that isn't on the order
  slot_unavailable // put-away into a blocked / quarantined / inactive slot
  slot_full // put-away into a slot without room
  box_unavailable // the box can't be used for this (quarantined, destroyed, ...)
}

enum ExceptionStatus {
  open
  resolved
}

// Supervisor queue (spec §6.3): scans that didn't match are recorded here instead of being silently corrected.
// Written OUTSIDE the failing request's transaction, so the record survives even though the scan was refused.
model OperationException {
  id          String          @id @default(uuid())
  type        ExceptionType
  status      ExceptionStatus @default(open)
  message     String
  orderId     String?
  orderNumber String?
  boxId       String?
  boxBarcode  String? // what was scanned (may not match any box)
  slotId      String?
  slotBarcode String?
  createdBy   Json
  createdAt   DateTime        @default(now())
  resolution  String?
  resolvedBy  Json?
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([orderId])
  @@map("operation_exception")
}

// ---------------------------------------------------------------------------------------------------------------
// Sprint 4 -- retention, legal holds, destruction certificates (spec §4.4)

enum RetentionTrigger {
  filing_date_to // years after the latest document in the box
  filing_date_from
  registered // years after the box was registered with us
}

// Versioned: changing a rule adds a new version (isCurrent moves); old versions stay for the record.
model RetentionRule {
  id             String           @id @default(uuid())
  code           String // what boxes carry in retentionCategory, e.g. "TAX"
  name           String
  retentionYears Int
  trigger        RetentionTrigger
  version        Int
  isCurrent      Boolean          @default(true)
  notes          String?
  createdBy      Json
  createdAt      DateTime         @default(now())

  @@unique([code, version])
  @@index([code, isCurrent])
  @@map("retention_rule")
}

enum LegalHoldScope {
  box
  client
  category
}

enum LegalHoldStatus {
  active
  released
}

// A legal hold always beats a destruction date: no box it covers can be destroyed while it is active.
model LegalHold {
  id          String          @id @default(uuid())
  scope       LegalHoldScope
  boxId       String?
  boxNumber   String?
  clientId    String?
  clientName  String?
  category    String? // retention category code
  authority   String // who asked for it (court, regulator, client's solicitor, ...)
  reason      String
  startsAt    DateTime        @db.Date
  endsAt      DateTime?       @db.Date
  status      LegalHoldStatus @default(active)
  createdBy   Json
  createdAt   DateTime        @default(now())
  releasedBy  Json?
  releasedAt  DateTime?
  releaseNote String?

  @@index([status, scope])
  @@index([boxId])
  @@index([clientId])
  @@map("legal_hold")
}

// Issued when a destruction order is completed. Content is frozen at issue and kept for good (audit / compliance proof).
model DestructionCertificate {
  id                String   @id @default(uuid())
  certificateNumber String   @unique // "COD-000001"
  orderId           String   @unique
  clientId          String
  clientName        String
  content           Json // { orderNumber, boxes[], method, authorisedBy, authorisedAt, approvedBy, approvedAt, destroyedBy, destroyedAt, witness?, place? }
  issuedBy          Json
  issuedAt          DateTime @default(now())

  @@index([clientId, issuedAt])
  @@map("destruction_certificate")
}

// ---------------------------------------------------------------------------------------------------------------
// Sprint 5 -- rate cards, charge events, box contents (spec §7)

// Effective-dated prices. clientId null = the default card for every client without its own.
model RateCard {
  id            String    @id @default(uuid())
  clientId      String?
  clientName    String?
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  rates         Json // { storagePerBoxMonth: { standard, large }, intakePerBox, retrievalPerBox, deliveryPerOrder, collectionPerOrder, destructionPerBox, digitizePerBox }
  taxRateId     String // Sage tax rate id for the charges
  notes         String?
  createdBy     Json
  createdAt     DateTime  @default(now())

  @@index([clientId, effectiveFrom])
  @@map("rate_card")
}

enum ChargeType {
  intake
  storage
  retrieval
  delivery
  collection
  destruction
  digitize
  other
}

enum ChargeStatus {
  open // priced, not on an invoice yet
  invoiced
  voided
}

// One priced, chargeable fact. The unique key makes generating the same period again a no-op (spec §7.2).
model ChargeEvent {
  id           String       @id @default(uuid())
  clientId     String
  clientName   String
  chargeType   ChargeType
  sourceType   String // "order" | "box" | "storage" | "manual"
  sourceKey    String // order id, box id, "<clientId>:<size>" for storage, uuid for manual
  periodStart  DateTime     @db.Date
  periodEnd    DateTime     @db.Date
  description  String
  quantity     Decimal      @db.Decimal(19, 4)
  unitPrice    Decimal      @db.Decimal(19, 4)
  amount       Decimal      @db.Decimal(19, 4)
  taxRateId    String
  rateCardId   String?
  status       ChargeStatus @default(open)
  billingRunId String?
  invoiceId    String?
  voidReason   String?
  createdBy    Json
  createdAt    DateTime     @default(now())

  @@unique([sourceType, sourceKey, chargeType, periodStart, periodEnd])
  @@index([clientId, periodStart])
  @@index([status, periodEnd])
  @@index([billingRunId])
  @@map("charge_event")
}

// What is in a box (file-level index), optionally pointing at the DocuSoft document.
model BoxContent {
  id                 String    @id @default(uuid())
  boxId              String
  box                Box       @relation(fields: [boxId], references: [id], onDelete: Cascade)
  description        String
  reference          String?
  dateFrom           DateTime? @db.Date
  dateTo             DateTime? @db.Date
  docusoftDocumentId String?
  createdBy          Json
  createdAt          DateTime  @default(now())

  @@index([boxId])
  @@map("box_content")
}

// ---------------------------------------------------------------------------------------------------------------
// Sprint 6 -- billing runs

enum BillingRunStatus {
  draft // charges reserved, being reviewed
  approved // frozen; one invoice per client was made
}

model BillingRun {
  id          String           @id @default(uuid())
  runNumber   String           @unique // "BR-000001"
  periodStart DateTime         @db.Date
  periodEnd   DateTime         @db.Date
  status      BillingRunStatus @default(draft)
  totals      Json? // { clients: [{ clientId, clientName, charges, amount }], amount } -- frozen on approval
  createdBy   Json
  createdAt   DateTime         @default(now())
  approvedBy  Json?
  approvedAt  DateTime?

  @@index([createdAt])
  @@map("billing_run")
}

// ---------------------------------------------------------------------------------------------------------------
// "Later" -- in-app notifications (email can be added behind the same rows)

model Notification {
  id           String   @id @default(uuid())
  audience     String // "client" | "staff"
  clientId     String? // client audience: whose
  contactEmail String? // client audience: only this contact (null = the client's main contacts and the order's contact)
  orderId      String?
  kind         String // e.g. order_approved, order_dispatched, needs_authorisation, needs_client_approval, certificate_issued
  title        String
  body         String?
  createdAt    DateTime @default(now())

  @@index([audience, clientId, createdAt])
  @@index([createdAt])
  @@map("notification")
}

// Atomic auto-increment (box numbers, per-type order numbers).
model Counter {
  id  String @id // "boxSeq" ya "orderSeq:dispatch"
  seq Int    @default(0)

  @@map("counter")
}
