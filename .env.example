PORT=5000
NODE_ENV=development

# Supabase Postgres -- Dashboard > Connect > "Session pooler" URI. Password me special chars
# ho to unhe URL-encode karo (# = %23, @ = %40, comma = %2C, / = %2F, ) = %29).
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Next.js frontend ka origin -- wms_session cookie ke credentialed CORS requests ke liye zaroori.
CORS_ORIGIN=http://localhost:3000

# Long random strings that sign login tokens (generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
# Keep them secret and never commit them. Changing one logs everyone of that kind out.
SESSION_JWT_SECRET=
PORTAL_JWT_SECRET=
PORTAL_TOKEN_TTL_MINUTES=60

# Origins of the client-portal pages (comma separated) that may call /api/portal from the browser.
PORTAL_ORIGINS=http://localhost:5500

# Set to 1 when the API sits behind a reverse proxy / load balancer (so rate limiting sees the real client IP).
TRUST_PROXY=0
